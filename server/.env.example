# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# API Keys for Property Data Providers
# Get your API keys from the respective providers:

# RapidAPI (Zillow API) - https://rapidapi.com/apimaker/api/zillow-com1
RAPIDAPI_KEY=your_rapidapi_key_here

# ATTOM Data - https://api.attomdata.com/
ATTOM_API_KEY=your_attom_api_key_here

# County Records API (varies by provider)
COUNTY_RECORDS_API_KEY=your_county_records_key_here
COUNTY_RECORDS_API_URL=https://api.countyrecords.example.com

# NMLS Consumer Access API
NMLS_API_KEY=your_nmls_key_here

# Optional: Caching (Redis)
REDIS_URL=redis://localhost:6379

# Optional: Analytics
ANALYTICS_KEY=your_analytics_key_here
