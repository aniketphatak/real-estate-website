# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ============================================
# FREE DATA SOURCES (No API key required!)
# ============================================
# The following sources work WITHOUT API keys:
# - Zillow (public endpoints) - Zestimates, property details
# - Redfin (public endpoints) - Property data, valuations
# - US Census Bureau - Demographics, housing stats
# - OpenStreetMap/Nominatim - Geocoding
# - County Open Data portals - Tax assessments

# Census Bureau API Key (OPTIONAL - for higher rate limits)
# Get FREE key from: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# HUD API Key (OPTIONAL - for fair market rent data)
# Get FREE key from: https://www.huduser.gov/hudapi/public/register
HUD_API_KEY=

# ============================================
# PAID API KEYS (Optional - for enhanced data)
# ============================================
# These provide more accurate mortgage, owner, and lien data
# The app works without these - they just add more data sources

# RapidAPI (Zillow & Realtor premium APIs)
# Get from: https://rapidapi.com/
RAPIDAPI_KEY=
RAPIDAPI_REALTOR_KEY=

# ATTOM Data - Comprehensive property data, mortgages, ownership
# Get from: https://api.attomdata.com/ (has free trial)
ATTOM_API_KEY=

# County Records API (varies by provider)
COUNTY_RECORDS_API_KEY=
COUNTY_RECORDS_API_URL=

# NMLS Consumer Access API
NMLS_API_KEY=

# ============================================
# OPTIONAL SERVICES
# ============================================

# Redis URL (for production caching)
REDIS_URL=redis://localhost:6379

# Google Maps API (for enhanced geocoding/autocomplete)
GOOGLE_MAPS_API_KEY=

# Analytics
ANALYTICS_KEY=
